# --- Parser -----------------------------------------------------------------

let grammar = `
  EXPRESSION              <- TERNARY
  TERNARY                 <- CONDITION ('?' EXPRESSION ':' EXPRESSION)?
  CONDITION               <- MULTIPLICATIVE (ConditionOperator MULTIPLICATIVE)?
  MULTIPLICATIVE          <- CALL (MultiplicativeOperator CALL)*
  CALL                    <- PRIMARY (EXPRESSION)?
  PRIMARY                 <- FOR / Identifier / '(' EXPRESSION ')' / String / Number
  FOR                     <- 'for' Identifier 'from' Number 'to' Number EXPRESSION

  ConditionOperator       <- '=='
  MultiplicativeOperator  <- '%'
  Identifier              <- !Keyword < [a-zA-Z][a-zA-Z0-9_]* >
  String                  <- "'" < (!"'" .)* > "'"
  Number                  <- < [0-9]+ >

  Keyword                 <- ('for' / 'from' / 'to') ![a-zA-Z]
  %whitespace             <- [ \t\r\n]*
`

fn fail(node, msg) {
  throw {kind: 'FizzBuzzError', message: msg, line: node.line, col: node.column}
}

# A type the program got wrong, reported at the node that made the value.
fn expect(type, value, at) {
  type_of(value) == type ? value : fail(at, 'type error.')
}

# --- Environment ------------------------------------------------------------

class Environment {
  new(outer = nil) {
    self.outer = outer
    self.values = {}
  }

  get_value(name, at) {
    cond {
      self.values.has(name) => self.values[name],
      self.outer != nil => self.outer.get_value(name, at),
      _ => fail(at, "undefined variable '{name}'..."),
    }
  }

  set_value(name, value) {
    self.values[name] = value
  }
}

# --- Interpreter ------------------------------------------------------------

fn eval(n, env) {
  match n {
    {name: 'TERNARY', nodes} => ternary(nodes, env),
    {name: 'CONDITION', nodes: [a, op, b]} => eval(a, env) == eval(b, env),
    {name: 'MULTIPLICATIVE', nodes} => multiplicative(nodes, env),
    {name: 'CALL', nodes} => call(nodes, env),
    {name: 'FOR', nodes} => exec_for(nodes, env),
    {name: 'Identifier', token} => env.get_value(token, n),
    {name: 'String', token} => token,
    {name: 'Number', token} => to_long(token),
    _ => fail(n, "cannot evaluate {n.name}"),
  }
}

fn ternary(nodes, env) {
  let [cond, yes, no] = nodes
  expect('Bool', eval(cond, env), cond) ? eval(yes, env) : eval(no, env)
}

fn multiplicative(nodes, env) {
  let [head, ...rest] = nodes
  mut value = expect('Long', eval(head, env), head)
  for [op, operand] in rest.iter().chunks(2) {
    let divisor = expect('Long', eval(operand, env), operand)
    value %= divisor == 0 ? fail(operand, 'division by zero.') : divisor
  }
  value
}

fn call(nodes, env) {
  let [primary, arg] = nodes
  let callee = env.get_value(primary.token, primary)
  expect('Function', callee, primary)(eval(arg, env))
}

fn exec_for(nodes, env) {
  let [ident, from_node, to_node, body] = nodes
  for i in eval(from_node, env)..=eval(to_node, env) {
    let call_env = Environment.new(env)
    call_env.set_value(ident.token, i)
    eval(body, call_env)
  }
}

# --- main -------------------------------------------------------------------

fn make_global_env() {
  let env = Environment.new()
  env.set_value('puts', |arg| println(arg))
  env
}

fn die(msg, code) {
  IO.eprintln(msg)
  Sys.exit(code)
}

let args = Sys.argv
if args.empty() {
  die('usage: culebra fzbz.cul [source file path]', 1)
}
let path = args[0]

try {
  let source = FS.read(path)
  let tree = PEG.parse(grammar, source, path: path)
  eval(tree, make_global_env())
} catch e {
  match e {
    {kind: 'IOError'} => die("can't open the source file.", 2),
    {kind: 'PEGError'} => die(e.message, 3),
    {kind: 'FizzBuzzError'} => die("{path}:{e.line}:{e.col}: {e.message}", 4),
    _ => throw e,  # a bug in this interpreter, not in the program it ran
  }
}
